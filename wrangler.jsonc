{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paper-trail",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  // Astro sessions. @astrojs/cloudflare v13 auto-injects a { binding: "SESSION" }
  // KV namespace with NO id, which is not deployable. Declaring it here with real
  // ids short-circuits that injection (see withSessionKVBinding in the adapter)
  // and keeps the binding deterministic, reviewable, and safe for non-interactive
  // CI — rather than relying on wrangler's interactive auto-provisioning prompt.
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "df70b747e9b848708dae2b7721fea1c2",
      "preview_id": "ca58c7687d7542aebd43ded2da17cae7",
    },
  ],
  // The adapter injects preview bindings separately from the top-level ones, so
  // without this block `wrangler versions upload` gets its own id-less SESSION
  // binding even though the one above is pinned.
  "previews": {
    "kv_namespaces": [
      {
        "binding": "SESSION",
        "id": "ca58c7687d7542aebd43ded2da17cae7",
      },
    ],
  },
  // Receipt downscaling (S-06). The adapter injects this binding at build time
  // because imageService defaults to "cloudflare-binding" (see astro.config.mjs),
  // but `wrangler types` only sees what is declared here — without it env.IMAGES
  // is a type error even though it works at runtime. The adapter's customizer
  // skips its own injection when the key is already present, so this is
  // idempotent rather than a duplicate.
  "images": {
    "binding": "IMAGES",
  },
  "assets": {
    "binding": "ASSETS",
    // Must be ./dist/client, NOT ./dist. The Astro adapter writes its own
    // config to dist/server/wrangler.json pointing at ../client, and wrangler
    // bridges the two via the gitignored .wrangler/deploy/config.json that only
    // a local build produces. If that redirect is ever missing, "./dist" would
    // publish dist/server/.dev.vars as a public static asset — the .assetsignore
    // that guards those files lives in dist/client/, not dist/.
    "directory": "./dist/client",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
}
