---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import DayView from "@/components/entries/DayView";
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-2xl">
      <Topbar />
      <div class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
        <DayView client:load />
      </div>
    </div>
  </div>
</Layout>
