---
const { user } = Astro.locals;

// The active tab is derived from the request path rather than passed in by each
// page, so a new page cannot forget to mark itself. `startsWith(href + "/")`
// keeps the tab lit for any future sub-route (e.g. `/reports/2026-08`).
const path = Astro.url.pathname;
const tabs = [
  { href: "/dashboard", label: "Dashboard" },
  { href: "/reports", label: "Raporty" },
];
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);

// `flex-wrap-reverse` is what makes the mobile stack come out in the right
// order from a single DOM order: on one line (laptop) the email sits left and
// the links right, and once they no longer fit, wrap-reverse stacks the LAST
// line on top — so the links land above the email rather than below it. The
// alternative (nav first in the DOM, reordered on `sm:`) would put the
// navigation ahead of the identity for screen readers on every viewport.
//
// `break-all` on the email is load-bearing, not defensive polish: an address
// has no spaces, so its min-content width is the whole string. Without it the
// span cannot shrink, the bar overflows the 360px viewport, and the *document*
// picks up a horizontal scrollbar — which is what showed as the whole page
// sitting left of a black gutter, since `bg-cosmic` only paints one
// viewport-width and `body`'s near-black propagates to the canvas beyond it.
---

<div
  class="mb-4 flex flex-wrap-reverse items-center justify-between gap-x-4 gap-y-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/80"
>
  {
    user ? (
      <>
        <span class="min-w-0 break-all text-blue-100/70">{user.email}</span>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          {/* The tabs live in their own segmented group so they read as one
              control with two states; the sign-out sits outside it, past a
              divider, because it is not a destination. */}
          <nav aria-label="Sekcje" class="flex items-center gap-1 rounded-lg border border-white/10 bg-white/5 p-1">
            {tabs.map((tab) => (
              <a
                href={tab.href}
                aria-current={isActive(tab.href) ? "page" : undefined}
                class:list={[
                  "rounded-md px-3 py-1.5 font-medium transition-colors",
                  isActive(tab.href)
                    ? "bg-purple-500/25 text-white shadow-sm ring-1 ring-purple-300/40"
                    : "text-purple-200 hover:bg-white/10 hover:text-white",
                ]}
              >
                {tab.label}
              </a>
            ))}
          </nav>
          <span aria-hidden="true" class="hidden h-5 w-px bg-white/15 sm:block" />
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="rounded-md border border-white/15 px-3 py-1.5 text-blue-100/80 transition-colors hover:border-white/30 hover:bg-white/10 hover:text-white"
            >
              Wyloguj się
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span class="min-w-0 break-all text-blue-100/70">Nie zalogowano</span>
        <div class="flex flex-wrap gap-3">
          <a href="/auth/signin" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Zaloguj się
          </a>
          <a href="/auth/signup" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Zarejestruj się
          </a>
        </div>
      </>
    )
  }
</div>
